# Create a Supabase project, then copy these values from Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Server-only. Do not expose this in a browser or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional local-development administrator. Use Supabase Auth in production.
ADMIN_EMAIL=admin@example.edu.np
ADMIN_PASSWORD=choose-a-strong-private-password
ADMIN_SESSION_SECRET=use-a-long-random-string-at-least-32-characters
